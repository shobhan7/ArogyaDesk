ENVIRONMENT=development
DATABASE_URL=sqlite:///./arogyadesk.db
JWT_SECRET=dev-only-change-me-before-any-shared-deployment
JWT_TTL_MINUTES=120
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=arogyadesk.appointments
CANCEL_CUTOFF_HOURS=2
CACHE_TTL_SECONDS=60
SEED=true
PASSWORD_ITERATIONS=120000
